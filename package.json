{
  "name": "stayos",
  "version": "0.1.0",
  "private": true,
  "description": "StayOS - Simple Hospitality Operating System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --project=chromium apps/web/e2e/auth-rbac.spec.ts apps/web/e2e/front-desk-smoke.spec.ts apps/web/e2e/check-in-wizard.spec.ts apps/web/e2e/checkout-flow-smoke.spec.ts apps/web/e2e/stay-billing-smoke.spec.ts",
    "test:e2e:ops": "playwright test --project=chromium apps/web/e2e/availability-group-smoke.spec.ts apps/web/e2e/housekeeping-room-status.spec.ts apps/web/e2e/responsive-layout-smoke.spec.ts",
    "test:e2e:checkin": "playwright test --project=chromium apps/web/e2e/check-in-wizard.spec.ts apps/web/e2e/responsive-layout-smoke.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "guides:staff": "node scripts/generate-staff-guides.mjs",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prisma:generate": "prisma generate"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "prettier": "latest",
    "prisma": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}

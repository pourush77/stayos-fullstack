{
  "name": "stayos",
  "version": "0.1.0",
  "private": true,
  "description": "StayOS - Simple Hospitality Operating System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @stayos/web run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prisma:generate": "prisma generate"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "prettier": "latest",
    "prisma": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}

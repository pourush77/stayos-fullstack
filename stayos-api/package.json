{
  "name": "stayos-api",
  "version": "0.1.0",
  "description": "StayOS Platform API foundation",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "bootstrap:hillston": "ts-node -r dotenv/config scripts/bootstrap-hillston.ts",
    "bootstrap:guests": "ts-node -r dotenv/config scripts/bootstrap-guests.ts",
    "bootstrap:reservations": "ts-node -r dotenv/config scripts/bootstrap-reservations.ts",
    "bootstrap:demo-reservations": "node scripts/bootstrap-demo-reservations.js",
    "bootstrap:demo": "node scripts/bootstrap/bootstrap-demo.js",
    "bootstrap:new-bookings": "node scripts/bootstrap-new-bookings.js",
    "bootstrap:demo-users": "node scripts/bootstrap-demo-users.js",
    "bootstrap:demo-employees": "node scripts/bootstrap-demo-employees.js",
    "verify:hillston": "ts-node -r dotenv/config scripts/verify-hillston.ts",
    "setup:dev": "docker compose up -d && npm install && npm run migration:run && npm run bootstrap:hillston",
    "sync:dev": "npm run migration:run && npm run bootstrap:hillston && npm run verify:hillston",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "helmet": "^7.0.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.11.0",
    "pino": "^10.0.0",
    "pino-pretty": "^11.0.0",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.0",
    "typeorm": "^0.3.19"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.1",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.11.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsdoc": "^39.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0"
  }
}

# Application
# Supported values: development, test, staging, production
NODE_ENV=development

# HTTP port used by the NestJS API. Must be between 1 and 65535.
PORT=3000

# PostgreSQL
# All database values are required. TypeORM synchronize stays disabled.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stayos_dev
DATABASE_USERNAME=stayos
DATABASE_PASSWORD=StayOS@2026

# TypeORM SQL logging. Keep false unless debugging locally.
TYPEORM_LOGGING=false

# JWT
# Development may use placeholders. Production values must be strong,
# non-placeholder secrets with at least 32 characters.
JWT_SECRET=supersecret
JWT_REFRESH_SECRET=superrefreshsecret

# Redis
# Redis is not enabled yet, so host/port may be omitted for now.
REDIS_HOST=localhost
REDIS_PORT=6379
